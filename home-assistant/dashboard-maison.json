{
  "title": "Maison",
  "views": [
    {
      "title": "Vue d'ensemble",
      "path": "ensemble",
      "icon": "mdi:home",
      "type": "sections",
      "theme": "Catppuccin Mocha",
      "max_columns": 4,
      "badges": [
        { "type": "entity", "entity": "weather.forecast_maison", "show_name": false, "show_state": true, "show_icon": true },
        { "type": "entity", "entity": "sun.sun", "show_name": false, "show_state": true, "show_icon": true },
        { "type": "entity", "entity": "sensor.cours_du_jour", "name": "Cours", "show_name": true, "show_state": true, "show_icon": true }
      ],
      "sections": [
        {
          "type": "grid",
          "cards": [
            { "type": "clock", "clock_style": "digital", "clock_size": "large", "time_format": "24", "show_seconds": false, "grid_options": { "columns": "full" } },
            {
              "type": "markdown",
              "content": "{% set j = ['lundi','mardi','mercredi','jeudi','vendredi','samedi','dimanche'] %}{% set m = ['janvier','février','mars','avril','mai','juin','juillet','août','septembre','octobre','novembre','décembre'] %}## {{ j[now().weekday()] | capitalize }} {{ now().day }} {{ m[now().month-1] }}",
              "grid_options": { "columns": "full" },
              "card_mod": { "style": "ha-markdown { text-align: center; }" }
            },
            { "type": "weather-forecast", "entity": "weather.forecast_maison", "show_current": true, "show_forecast": true, "forecast_type": "daily" }
          ]
        },
        {
          "type": "grid",
          "cards": [
            { "type": "heading", "heading": "Cours du jour", "heading_style": "title", "icon": "mdi:school" },
            {
              "type": "markdown",
              "content": "{{ state_attr('sensor.cours_du_jour','cours_texte') }}",
              "card_mod": { "style": "ha-markdown { font-size: 1.5rem; line-height: 1.6; }" }
            },
            { "type": "heading", "heading": "Agenda", "heading_style": "title", "icon": "mdi:calendar" },
            { "type": "calendar", "entities": ["calendar.calendrier_google"], "initial_view": "listWeek" }
          ]
        },
        {
          "type": "grid",
          "cards": [
            { "type": "heading", "heading": "Lumières", "heading_style": "title", "icon": "mdi:lightbulb-group" },
            { "type": "custom:mushroom-template-card", "primary": "Tout allumer", "secondary": "", "icon": "mdi:lightbulb-on", "icon_color": "green", "fill_container": true, "layout": "horizontal", "tap_action": { "action": "perform-action", "perform_action": "scene.turn_on", "target": { "entity_id": "scene.lumieres_on" } } },
            { "type": "custom:mushroom-template-card", "primary": "Tout éteindre", "secondary": "", "icon": "mdi:lightbulb-off", "icon_color": "blue-grey", "fill_container": true, "layout": "horizontal", "tap_action": { "action": "perform-action", "perform_action": "scene.turn_on", "target": { "entity_id": "scene.lumieres_off" } } },
            { "type": "custom:mushroom-light-card", "entity": "light.panneau_gauche", "name": "Panneau gauche", "show_brightness_control": true, "use_light_color": true, "fill_container": true, "layout": "horizontal" },
            { "type": "custom:mushroom-light-card", "entity": "light.panneau_droit", "name": "Panneau droit", "show_brightness_control": true, "use_light_color": true, "fill_container": true, "layout": "horizontal" },
            { "type": "custom:mushroom-light-card", "entity": "light.etageres", "name": "Étagères", "show_brightness_control": true, "use_light_color": true, "fill_container": true, "layout": "horizontal" },
            { "type": "custom:mushroom-light-card", "entity": "light.ampoule", "name": "Ampoule", "show_brightness_control": true, "use_light_color": true, "fill_container": true, "layout": "horizontal" },
            { "type": "custom:mushroom-light-card", "entity": "light.led", "name": "LED", "show_brightness_control": true, "use_light_color": true, "fill_container": true, "layout": "horizontal" }
          ]
        },
        {
          "type": "grid",
          "cards": [
            { "type": "heading", "heading": "Musique", "heading_style": "title", "icon": "mdi:spotify" },
            { "type": "custom:mushroom-media-player-card", "entity": "media_player.maison_spotify", "name": "Spotify", "use_media_info": true, "use_media_artwork": true, "show_volume_level": false, "media_controls": ["on_off", "shuffle", "previous", "play_pause_stop", "next", "repeat"], "collapsible_controls": false, "fill_container": true },
            { "type": "tile", "entity": "media_player.chambre_tom", "name": "Google Home", "vertical": false, "features": [{ "type": "media-player-volume-slider" }], "features_position": "bottom" },
            { "type": "heading", "heading": "Courses", "heading_style": "title", "icon": "mdi:cart" },
            { "type": "todo-list", "entity": "todo.shopping_list" }
          ]
        }
      ]
    }
  ]
}
